{# Example 1: Vertical Scrollspy #}
<twig:block-scrollspy
    class="my-4 shadow-none"
    height="360px"
    :cols="3"
    :sections="[
        {
            id: 'introduction',
            title: 'Introduction',
            content: section_content_introduction
        },
        {
            id: 'features',
            title: 'Features',
            content: section_content_features
        },
        {
            id: 'options',
            title: 'Configuration',
            content: section_content_options
        }
    ]"
/>

<hr class="my-4"/>

{# Example 2: Horizontal Scrollspy #}
<twig:block-scrollspy
    class="my-4 shadow"
    height="300px"
    orientation="horizontal"
    :cols="12"
    :sections="[
        {
            id: 'introduction-h',
            title: 'Introduction',
            content: section_content_introduction,
        },
        {
            id: 'features-h',
            title: 'Features',
            content: section_content_features,
        },
        {
            id: 'options-h',
            title: 'Configuration',
            content: section_content_options,
        },
        {
            id: 'usage-h',
            title: 'Getting started',
            content: section_content_usage,
        }
    ]"
/>


