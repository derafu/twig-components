---
title: Hero
description: Hero section for landing pages.
show_title: true
show_description: true
hide_table_of_contents: true
show_source: true
---

<p class="lead mx-3 my-4">Compare sizes, alignment, images, solid colors and content backgrounds on every screen width.</p>
<h2 class="h4 mx-3 mt-4">Standard variants</h2>

<twig:block-hero
   class="my-4"
   align="left"
   background="assets/derafu-dev-programmer.png"
   title="Lorem <a href='https://www.example.com/' target='_blank'>ipsum</a>"
   subtitle="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
   :buttons="[
       {
           text: 'Example.com',
           url: 'https://www.example.com'
       }
   ]"
/>

<twig:block-hero
   class="my-4"
   align="left"
   background="assets/derafu-dev-programmer.png"
   contentBackground="true"
   title="Lorem ipsum"
   subtitle="Lorem ipsum dolor sit amet, consectetur <a href='https://www.example.com/' target='_blank'>adipiscing elit.</a>"
   :buttons="[
       {
           text: 'Example.com',
           url: 'https://www.example.com'
       }
   ]"
/>

<twig:block-hero
   class="my-4"
   align="right"
   background="assets/derafu-dev-programmer.png"
   title="Lorem ipsum"
   subtitle="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
   :buttons="[
       {
           text: 'Example.com',
           url: 'https://www.example.com'
       }
   ]"
/>

<twig:block-hero
    class="my-4"
    title="Hero"
    subtitle="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
    :buttons="[
        {
            text: 'Example.com 1',
            url: 'https://www.example.com'
        },
        {
            text: 'Example.com 2',
            url: 'https://www.example.com'
        }
    ]"
/>

{% set sizes = ['mini', 'small', 'medium', 'large', 'full'] %}
{% for size in sizes %}
   <twig:block-hero
       class="my-4"
       align="right"
       size="{{ size }}"
       background="assets/derafu-dev-programmer.png"
       title="Size: {{ size }}"
       subtitle="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
       :buttons="[
           {
               text: 'Example.com',
               url: 'https://www.example.com'
           }
       ]"
   />
{% endfor %}


<h2 class="h4 mx-3 mt-5">Long content and layout checks</h2>
{% for align in ['left', 'center', 'right'] %}
<h3 class="h5 mt-4">Solid color, {{ align }} alignment</h3>
<twig:block-hero class="my-4" size="mini" align="{{ align }}" background="#17365d" title="A longer introduction to the <a href='#'>service</a>" subtitle="A solid background and the requested alignment remain visible on small screens." :buttons="[{text: 'Review the configuration options for my company', url: '#'}, {text: 'Contact us', url: '#', type: 'secondary'}]" />
{% endfor %}
<twig:block-hero class="my-4" background="rgb(23, 54, 93)" contentBackground="rgba(0, 0, 0, 0.5)" title="A CSS color and a custom content background" subtitle="Both backgrounds use the supplied colors." />
<twig:block-hero class="my-4" background="rebeccapurple" title="A named CSS color" subtitle="Named colors use the browser color support." />

<twig:block-hero class="my-4" size="full" :fullWidth="true" style="--hero-height-full: 65vh;" background="var(--bs-primary)" title="Full width with a custom minimum height" subtitle="The full size honors its CSS height variable on both desktop and mobile." />
