{# templates/components/block-image-grid.html.twig #}

<div class="derafu-block-image-grid {{ attributes.render('class') }}" {{ attributes }} id="{{ this.id }}">
    <div class="row mx-0 g-4">
        {% for image in this.images %}
            <div class="col-6 col-md-4 {% if this.cols == 4 %}col-lg-3{% elseif this.cols == 3 %}col-lg-4{% else %}col-lg-2{% endif %}">
                <div class="derafu-block-image-grid__item p-2">
                    {% if (image.url ?? null) %}
                        <a href="{{ (image.url ?? null) }}" class="derafu-block-image-grid__link" {% if (image.tooltip ?? null) %}data-bs-toggle="tooltip" title="{{ (image.tooltip ?? null) }}"{% endif %}>
                            <img src="{{ (image.image ?? null) }}" alt="{{ image.alt ?? image.tooltip|default('') }}" class="derafu-block-image-grid__image">
                        </a>
                    {% else %}
                        <img src="{{ (image.image ?? null) }}" alt="{{ image.alt ?? image.tooltip|default('') }}" class="derafu-block-image-grid__image" {% if (image.tooltip ?? null) %}data-bs-toggle="tooltip" title="{{ (image.tooltip ?? null) }}"{% endif %}>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const tooltipTriggerList = [].slice.call(document.getElementById('{{ this.id|e('js') }}').querySelectorAll('[data-bs-toggle="tooltip"]'));
        tooltipTriggerList.map(function(tooltipTriggerEl) {
            return bootstrap.Tooltip.getOrCreateInstance(tooltipTriggerEl);
        });
    });
</script>
{% endblock %}
