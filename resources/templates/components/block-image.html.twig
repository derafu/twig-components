{# templates/components/block-image.html.twig #}
<div
    class="derafu-block-image{{ this.contained ? ' derafu-block-image--contained' : '' }} derafu-block-image--{{ this.align }} derafu-block-image--{{ this.size }} {{ attributes.render('class') }}"
    {{ attributes }}
    id="{{ this.id }}"
>
    {% if this.contained %}<div class="derafu-block-image__inner container">{% endif %}
    <div class="derafu-block-image__wrapper">
        {% if this.eyebrow is not null and this.eyebrow != '' %}
            <div class="derafu-block-image__eyebrow">{{ this.eyebrow|raw }}</div>
        {% endif %}
        {% if this.title %}
            <h2 class="derafu-block-image__title">{{ this.title|raw }}</h2>
        {% endif %}

        {% if this.content and this.contentPosition == 'before' %}
            <div class="derafu-block-image__content">
                {{ this.content|raw }}
            </div>
        {% endif %}

        <div class="derafu-block-image__image">
            <img src="{{ this.image }}" alt="{{ this.imageAlt ?? this.title|striptags }}" class="img-fluid">
        </div>

        {% if this.content and this.contentPosition != 'before' %}
            <div class="derafu-block-image__content">
                {{ this.content|raw }}
            </div>
        {% endif %}

        {% if this.buttons|length > 0 %}
            <div class="derafu-block-image__buttons">
                {% for button in this.buttons %}
                    <a href="{{ (button.url ?? null) }}" class="derafu-block-image__button {{ (button.url ?? null) ? '' : 'disabled' }}">
                        {{ (button.text ?? null) }}
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    {% if this.contained %}</div>{% endif %}
</div>
