{# templates/components/block-video.html.twig #}

<div
    class="derafu-block-video{{ this.contained ? ' derafu-block-video--contained' : '' }} {{ attributes.render('class') }}"
    {{ attributes }}
    id="{{ this.id }}"
>
    {% if this.contained %}<div class="derafu-block-video__inner container">{% endif %}
    <div class="derafu-block-video__wrapper derafu-block-video--{{ this.align ?? 'center' }} derafu-block-video--{{ this.size ?? 'normal' }}">
        {% if this.eyebrow is not null and this.eyebrow != '' %}
            <div class="derafu-block-video__eyebrow">{{ this.eyebrow|raw }}</div>
        {% endif %}
        {% if this.title %}
            <h2 class="derafu-block-video__title">{{ this.title|raw }}</h2>
        {% endif %}

        {% if this.content and this.contentPosition == 'before' %}
            <div class="derafu-block-video__content">
                {{ this.content|raw }}
            </div>
        {% endif %}

        <div class="derafu-block-video__media">
            <iframe
                class="derafu-block-video__player"
                title="{{ this.title|striptags }}"
                {% if this.aspectRatio != '16:9' %}style="--video-aspect-ratio: {{ this.aspectRatio|replace({':': ' / '}) }};"{% endif %}
                src="{{ this.video|replace({'watch?v=': 'embed/'}) }}"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
            >
            </iframe>
        </div>

        {% if this.content and this.contentPosition != 'before' %}
            <div class="derafu-block-video__content">
                {{ this.content|raw }}
            </div>
        {% endif %}

        {% if this.buttons|length > 0 %}
            <div class="derafu-block-video__buttons">
                {% for button in this.buttons %}
                    <a href="{{ (button.url ?? null) }}" class="derafu-block-video__button">
                        {{ (button.text ?? null) }}
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    {% if this.contained %}</div>{% endif %}
</div>
