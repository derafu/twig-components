{# templates/components/block-card-grid.html.twig #}

<div class="derafu-block-card-grid {{ attributes.render('class') }}" {{ attributes }} id="{{ this.id }}">
    <div class="row g-4">
        {% for card in this.cards %}
            <div class="col-sm-6 {% if this.cols == 1 %}col-lg-12
                {% elseif this.cols == 2 %}col-lg-6
                {% elseif this.cols == 3 %}col-lg-4
                {% elseif this.cols == 4 %}col-lg-3
                {% else %}col-lg-2{% endif %}
                {% if (card.offset ?? null) is not null %}offset-lg-{{ (card.offset ?? null) }}{% endif %}
            ">
                {% if (card.url ?? null) %}
                    <a href="{{ (card.url ?? null) }}" class="derafu-block-card-grid__card derafu-block-card-grid__card--linked">
                {% else %}
                    <div class="derafu-block-card-grid__card">
                {% endif %}

                    {% if (card.image ?? null) %}
                        <div class="derafu-block-card-grid__image">
                            <img src="{{ (card.image ?? null) }}" alt="{{ (card.title ?? null) }}">
                        </div>
                    {% endif %}

                    {% if (card.icon ?? null) %}
                        <div class="derafu-block-card-grid__icon">
                            <span class="{{ (card.icon ?? null) }}"></span>
                        </div>
                    {% endif %}

                    <div class="derafu-block-card-grid__body">
                        {% if (card.label ?? null) %}
                            <p class="derafu-block-card-grid__label">{{ (card.label ?? null) }}</p>
                        {% endif %}

                        {% if (card.title ?? null) %}
                            <h3 class="derafu-block-card-grid__title">{{ (card.title ?? null)|raw }}</h3>
                        {% endif %}

                        {% if (card.content ?? null) %}
                            <div class="derafu-block-card-grid__content">
                                {{ (card.content ?? null)|raw }}
                            </div>
                        {% endif %}
                    </div>

                    {% if (card.buttonText ?? null) %}
                        <div class="derafu-block-card-grid__footer">
                            <a href="{{ (card.buttonUrl ?? null) }}"
                               class="btn w-100
                                       {% if card.buttonColor is defined and (card.buttonColor ?? null) %}btn-{{ (card.buttonColor ?? null) }}{% else %}btn-primary{% endif %}
                                       {% if (card.buttonUrl ?? null) is empty %}disabled{% endif %}"
                               role="button"
                               {% if card.buttonStyle is defined and (card.buttonStyle ?? null) %}style="{{ (card.buttonStyle ?? null) }}"{% endif %}>
                                {{ (card.buttonText ?? null) }}
                            </a>
                        </div>
                    {% endif %}

                {% if (card.url ?? null) %}
                    </a>
                {% else %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>
