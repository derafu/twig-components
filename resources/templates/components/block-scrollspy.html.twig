{# templates/components/block-scrollspy.html.twig #}

<div
    class="derafu-block-scrollspy derafu-block-scrollspy--{{ this.orientation }} row {{ attributes.render('class') }}"
    {{ attributes }}
    id="{{ this.id }}"
    {% if this.style %}style="{{ this.style }}"{% endif %}
>

    {# Navigation List - automatically adjusts based on device #}
    <div class="derafu-block-scrollspy__list col-md-{{ this.cols }} col-12">
        <div
            id="{{ this.id }}-{% if this.orientation == 'horizontal' %}list-scrollspy-horizontal{% else %}list-scrollspy-vertical{% endif %}"
            class="list-group {% if this.orientation != 'vertical' %}list-group-{{ this.orientation }}{% else %}list-group-horizontal-md d-md-block{% endif %}"
        >
            {% for section in this.sections %}
                <div class="derafu-block-scrollspy__list-item">
                    <a class="list-group-item list-group-item-action" href="#{{ (section.id ?? null) }}">
                        {% if (section.icon ?? null) %}<i class="fas {{ (section.icon ?? null) }} me-2"></i>{% endif %}
                        {{ (section.title ?? null) }}
                        {% if (section.badge ?? null) %}<span class="badge bg-primary float-end">{{ (section.badge ?? null) }}</span>{% endif %}
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>

    {# Scrollspy Content - without fixed height on mobile #}
    <div class="derafu-block-scrollspy__content col-md-{{ 12 - this.cols }} col-12" style="--scrollspy-height: {{ this.height }};">
        <div
            data-bs-spy="scroll"
            {% if this.orientation == 'horizontal' %}
                data-bs-orientation="horizontal"
            {% endif %}
            data-bs-target="#{{ this.id }}-{% if this.orientation == 'horizontal' %}list-scrollspy-horizontal{% else %}list-scrollspy-vertical{% endif %}"
            data-bs-offset="0"
            data-bs-smooth-scroll="true"
            class="scrollspy-example p-3"
            tabindex="0"
        >
            {% for section in this.sections %}
                <div id="{{ (section.id ?? null) }}" class="derafu-block-scrollspy__section mb-4">
                    <h4 class="mb-3 pb-2 border-bottom">{{ (section.title ?? null) }}</h4>
                    <div class="derafu-block-scrollspy__section-content">
                        {{ (section.content ?? null)|raw }}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

{% block javascripts %}
<script>
    (() => {
        const initialize = () => {
            const root = document.getElementById('{{ this.id|e('js') }}');
            const content = root?.querySelector('.scrollspy-example');
            if (!content || typeof bootstrap === 'undefined') {
                return;
            }
            const spy = bootstrap.ScrollSpy.getOrCreateInstance(content);
            window.addEventListener('resize', () => spy.refresh());
        };
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initialize, { once: true });
        } else {
            initialize();
        }
    })();
</script>
{% endblock %}
