{# templates/components/block-features-grid.html.twig #}

<div class="derafu-block-features-grid {{ attributes.render('class') }}" {{ attributes }} id="{{ this.id }}">
    <div class="derafu-block-features-grid__row">
        {% for block in this.blocks %}
            <div class="derafu-block-features-grid__block">
                <div class="derafu-block-features-grid__header">
                    <h3 class="derafu-block-features-grid__title">{{ (block.title ?? null)|raw }}</h3>
                    <p class="derafu-block-features-grid__subtitle">{{ (block.subtitle ?? null)|raw }}</p>
                </div>

                <div class="derafu-block-features-grid__features">
                    {% for feature in (block.features ?? null) %}
                        <div class="derafu-block-features-grid__feature">
                            <div class="derafu-block-features-grid__icon">
                                <i class="{{ (feature.icon ?? null) }}"></i>
                            </div>
                            <div class="derafu-block-features-grid__content">
                                <h4 class="derafu-block-features-grid__feature-title">{{ (feature.title ?? null)|raw  }}</h4>
                                <div class="derafu-block-features-grid__content">
                                    {{ (feature.content ?? null)|raw }}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
