                                   class="derafu-block-footer__social-icon {% if this.socialIconsCircular %}derafu-block-footer__social-icon--circular{% endif %}"
                                   {% if icon.color is defined %}style="--social-icon-color: {{ (icon.color ?? null) }};"{% endif %}>
                                    <i class="{{ (icon.icon ?? null) }} {% if icon.size is defined %}{{ (icon.size ?? null) }}{% endif %}"></i>
