{# templates/components/block-footer.html.twig #}

<footer class="derafu-block-footer {{ attributes.render('class') }}" {{ attributes }} id="{{ this.id }}">
    <div {% if this.fullWidth is empty %}class="container"{% endif %}>
        <div class="row">
            {# Column 1 #}
            {% if this.col1Title or this.col1Html or this.col1Links is not empty or this.col1SocialIcons is not empty %}
                <div class="col">
                    {% if this.col1Title %}
                        <h5 class="derafu-block-footer__title mb-4">{{ this.col1Title }}</h5>
                    {% endif %}
                    {% if this.col1Html %}
                        <div class="derafu-block-footer__text mb-4">{{ this.col1Html|raw }}</div>
                    {% endif %}
                    {% if this.col1Links is not empty %}
                        <ul class="derafu-block-footer__links list-unstyled">
                            {% for link in this.col1Links %}
                                <li>
                                    <a href="{{ (link.url ?? null) }}" {% if (link.targetBlank ?? null) %}target="_blank" rel="noopener"{% endif %}>
                                        {% if link.icon is defined %}
                                            <i class="{{ (link.icon ?? null) }} me-2"></i>
                                        {% endif %}
                                        {{ (link.text ?? null) }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    {% if this.col1SocialIcons is not empty %}
                        <div class="derafu-block-footer__social mt-4">
                            {% for icon in this.col1SocialIcons %}
                                <a href="{{ (icon.url ?? null) }}"
                                   {% if (icon.targetBlank ?? null) %}target="_blank" rel="noopener"{% endif %}
                                   class="derafu-block-footer__social-icon {% if this.socialIconsCircular %}derafu-block-footer__social-icon--circular{% endif %}"
                                   {% if icon.color is defined %}style="--social-icon-color: {{ (icon.color ?? null) }};"{% endif %}>
                                    <i class="{{ (icon.icon ?? null) }} {% if icon.size is defined %}{{ (icon.size ?? null) }}{% endif %}"></i>
                                </a>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            {% endif %}

            {# Column 2 #}
            {% if this.col2Title or this.col2Html or this.col2Links is not empty or this.col2SocialIcons is not empty %}
