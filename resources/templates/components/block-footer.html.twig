    </div>

    {# Footer Bottom #}
    {% if this.leftText or this.rightText %}
        <div class="derafu-block-footer__bottom">
            <div {% if this.fullWidth is empty %}class="container"{% endif %}>
                <div class="row">
                    <div class="col-md">
                        {% if this.leftText %}
                            <div class="derafu-block-footer__bottom-text">{{ this.leftText|raw }}</div>
                        {% endif %}
                    </div>
                    <div class="col-md text-md-end">
                        {% if this.rightText %}
                            <div class="derafu-block-footer__bottom-text">{{ this.rightText|raw }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</footer>
