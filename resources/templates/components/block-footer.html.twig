                    {% endif %}
                    {% if this.col4Links is not empty %}
                        <ul class="derafu-block-footer__links list-unstyled">
                            {% for link in this.col4Links %}
                                <li>
                                    <a href="{{ (link.url ?? null) }}" {% if (link.targetBlank ?? null) %}target="_blank" rel="noopener"{% endif %}>
