<div
    class="block-media-list {{ attributes.render('class') }}"
    {{ attributes }}
    id="{{ this.id }}"
>
    <div class="{{ this.container | default('container') }}">
        {% for item in this.items %}
            <div class="media-item overflow-hidden {{ this.rounded ? 'rounded' : '' }}">
                <div class="row">
                    <div class="media-item-image col-md-4">
                        <img src="{{ (item.image ?? null) }}" alt="{{ item.imageAlt ?? (item.title|default('')|striptags) }}" class="img-fluid">
                    </div>
                    <div class="media-item-content col-md-8">
                        <div class="media-item-body">
                            {% if item.title is defined and (item.title ?? null) %}
                                <h{{ this.titleLevel }} class="media-item-content-title">{{ (item.title ?? null) }}</h{{ this.titleLevel }}>
                            {% endif %}
                            <div class="media-item-content-content">
                                {{ (item.content ?? null) | raw }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
