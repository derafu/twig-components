{# templates/components/block-video-grid.html.twig #}

<div
    class="derafu-block-video-grid {{ attributes.render('class') }}"
    {{ attributes }}
    id="{{ this.id }}"
>
    <div class="row g-4">
        {% for video in this.videos %}
            <div class="col-sm-6 {% if this.cols == 1 %}col-lg-12
                {% elseif this.cols == 2 %}col-lg-6
                {% elseif this.cols == 3 %}col-lg-4
                {% elseif this.cols == 4 %}col-lg-3
                {% else %}col-lg-2{% endif %}">

                <div class="derafu-block-video-grid__card
                    {% if (video.title ?? null) is empty and (video.content ?? null) is empty %}border border-0{% endif %}"
                >
                    <div class="derafu-block-video-grid__media">
                        <iframe
                            class="derafu-block-video-grid__player"
                            src="{{ (video.video ?? null)|replace({'watch?v=': 'embed/'}) }}"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen>
                        </iframe>
                    </div>

                    {% if (video.title ?? null) or (video.content ?? null) %}
                        <div class="derafu-block-video-grid__content">
                            {% if (video.title ?? null) %}
                                <h3 class="derafu-block-video-grid__title">{{ (video.title ?? null)|raw }}</h3>
                            {% endif %}

                            {% if (video.content ?? null) %}
                                <div class="derafu-block-video-grid__content">
                                    {{ (video.content ?? null)|raw }}
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}

                    {% if (video.buttonText ?? null) %}
                        <div class="derafu-block-video-grid__footer">
                            <a href="{{ (video.buttonUrl ?? null) }}" class="derafu-block-video-grid__button btn {% if (video.buttonUrl ?? null) is empty %}disabled{% endif %}" role="button">
                                {{ (video.buttonText ?? null) }}
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
