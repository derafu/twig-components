{# templates/components/block-text-video.html.twig #}

<div
    class="derafu-block-text-video {{ attributes.render('class') }}"
    {{ attributes }}
    id="{{ this.id }}"
>
    <div class="row mx-0 align-items-center">
        {# Text Column #}
        <div class="col-12 col-md-{{ this.cols }} {% if this.videoPosition == 'left' %}order-md-2{% endif %}">
            <div class="derafu-block-text-video__content">
                {% if this.eyebrow is not null and this.eyebrow != '' %}
                    <div class="derafu-block-text-video__eyebrow">{{ this.eyebrow|raw }}</div>
                {% endif %}
                <h2 class="derafu-block-text-video__title">{{ this.title|raw }}</h2>
                {% if this.lead is not null and this.lead != '' %}
                    <div class="derafu-block-text-video__lead lead">{{ this.lead|raw }}</div>
                {% endif %}
                <div class="derafu-block-text-video__text">
                    {{ this.content|raw }}
                </div>
                {% if this.items|length > 0 %}
                    <ul class="derafu-block-text-video__items list-unstyled d-grid">
                        {% for item in this.items %}
                            {% set has_link = item.url is defined and item.url is not null and item.url != '' %}
                            <li class="d-flex align-items-baseline">
                                {% if has_link %}<a class="d-flex align-items-baseline" href="{{ item.url }}">{% endif %}
                                {% if item.icon ?? null %}
                                    <i class="{{ item.icon }}" aria-hidden="true"></i>
                                {% endif %}
                                <div>{{ item.text|raw }}</div>
                                {% if has_link %}</a>{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
                {% if this.badge is not null and this.badge != '' %}
                    <div class="derafu-block-text-video__badge"><div class="badge">{{ this.badge|raw }}</div></div>
                {% endif %}
                {% if this.note is not null and this.note != '' %}
                    <div class="derafu-block-text-video__note small">{{ this.note|raw }}</div>
                {% endif %}
                {% if this.buttons|length > 0 %}
                    <div class="derafu-block-text-video__buttons">
                        {% for button in this.buttons %}
                            <a href="{{ (button.url ?? null) }}" class="derafu-block-text-video__button">
                                {{ (button.text ?? null) }}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        {# Video Column #}
        <div class="col-12 col-md-{{ 12 - this.cols }} {% if this.videoPosition == 'left' %}order-md-1{% endif %}">
            <div class="derafu-block-text-video__media-wrapper">
                <div class="derafu-block-text-video__media derafu-block-text-video__media--{{ this.aspectRatio|replace({':': '-'}) }}">
                    <iframe
                        src="{{ this.video }}{% if not this.showControls %}?controls=0{% endif %}"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                    ></iframe>
                </div>
            </div>
        </div>
    </div>
</div>
