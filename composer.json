{
    "name": "derafu/twig-components",
    "description": "Derafu: Twig Components - UI components for Twig and Symfony",
    "type": "library",
    "homepage": "https://www.derafu.dev/docs/ui/twig-components",
    "license": "MIT",
    "authors": [
        {
            "name": "Esteban De La Fuente Rubio / Derafu",
            "homepage": "https://www.derafu.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/derafu/twig-components/issues",
        "source": "https://github.com/derafu/twig-components"
    },
    "autoload": {
        "psr-4": {
            "Derafu\\TwigComponents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Derafu\\TestsTwigComponents\\": "tests/src/"
        }
    },
    "require": {
        "php": "^8.5",
        "derafu/translation": "dev-main",
        "symfony/ux-twig-component": "^2.36"
    },
    "require-dev": {
        "derafu/twig": "dev-main",
        "ext-xdebug": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "nikic/php-parser": "^5.9",
        "symfony/framework-bundle": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/translation": "^8.1"
    },
    "scripts": {
        "docs": "php tools/phpdocumentor run --config=phpdoc.xml",
        "tests": "XDEBUG_MODE=coverage vendor/bin/phpunit --configuration=phpunit.xml",
        "phpcs-fix": "vendor/bin/php-cs-fixer fix -v --config=php-cs-fixer.php",
        "phpcs": "vendor/bin/php-cs-fixer fix -v --dry-run --diff --config=php-cs-fixer.php",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
        "phpstan-export": "vendor/bin/phpstan analyse --configuration=phpstan.neon --level 9 --generate-baseline"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "derafu/twig": "Required by the optional Derafu Twig integration in twig-components-twig-services.yaml.",
        "nikic/php-parser": "Required by the tests of the messages of the package (Derafu\\Translation\\Lint reads the code).",
        "symfony/framework-bundle": "To use the components in a Symfony application (see the README)."
    }
}
